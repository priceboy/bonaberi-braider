# Django settings. Copy this file to .env and fill in real values.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Production database (Supabase Postgres). When set, the app uses Postgres;
# otherwise it falls back to local SQLite. Include ?sslmode=require.
DATABASE_URL=

# Media storage via Supabase Storage (S3-compatible API).
# Set SUPABASE_S3_BUCKET to send admin image uploads to the cloud. When unset,
# uploads are stored locally in ./media (development only).
# In Supabase: Project Settings > Storage > "New S3 access key". Use a PUBLIC bucket.
SUPABASE_S3_BUCKET=
SUPABASE_S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# Public base URL for the bucket so images are viewable everywhere.
SUPABASE_S3_PUBLIC_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/BUCKET