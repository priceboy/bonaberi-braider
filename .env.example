# Django settings. Copy this file to .env and fill in real values.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Production database (Supabase Postgres). Include ?sslmode=require.
DATABASE_URL=

# Admin-uploaded media via Supabase Storage's S3-compatible API.
# Create a PUBLIC bucket and generate S3 credentials in Supabase Storage settings.
SUPABASE_S3_BUCKET=phanies-images
SUPABASE_S3_ENDPOINT=https://hhqqmpdnybuuatkdwyqf.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=eu-north-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# Public URL base for this bucket (not the S3 endpoint).
SUPABASE_S3_PUBLIC_URL=https://hhqqmpdnybuuatkdwyqf.supabase.co/storage/v1/object/public/phanies-images
